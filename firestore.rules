rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user (including anonymous auth) can read user profiles,
    // so phone-number lookup works. Users can only write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Only the two real participants in a chat can read/write it and its messages.
    match /chats/{chatId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // Group chat typing indicators — readable/writable by any signed-in user for now.
    // Tighten this once group membership is enforced server-side.
    match /group_chats/{chatId}/typing_indicators/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
